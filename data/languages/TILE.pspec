<?xml version="1.0" encoding="UTF-8"?>
<processor_spec>
  <programcounter register="pc"/>
  <!-- The network registers are hardware FIFOs (every read pops, every write pushes); the SPRs are
       control and status registers, many with side effects. -->
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="register" first="0x1c8" last="0x1f7"/>
    <range space="register" first="0x10000" last="0x2ffff"/>
  </volatile>
